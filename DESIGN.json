{
  "theme": {
    "colors": {
      "bg": {
        "primary": "#09090B",
        "surface": "#18181B",
        "overlay": "rgba(9, 9, 11, 0.8)"
      },
      "text": {
        "primary": "#E4E4E7",
        "secondary": "#A1A1AA",
        "muted": "#52525B",
        "inverse": "#09090B"
      },
      "accent": {
        "primary": "#D97706",
        "hover": "#F59E0B"
      }
    },
    "typography": {
      "fonts": {
        "display": "Cormorant Garamond, Georgia, serif",
        "body": "Montserrat, Helvetica, sans-serif"
      },
      "sizes": {
        "display-xl": "5.5rem",
        "display-lg": "3.5rem",
        "body": "1rem",
        "label": "0.75rem"
      },
      "mobile": {
        "display-xl": "2.75rem",
        "display-lg": "2rem"
      }
    },
    "grid": {
      "padding": "10vw",
      "density-cap": 0.3,
      "body-width-max": "540px"
    },
    "breakpoints": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px"
    },
    "motion": {
      "duration": {
        "pillar-entrance": 2.5,
        "headline-stagger": 1.2
      },
      "easing": {
        "entrance": "power3.out",
        "text": "power4.out"
      }
    }
  }
}
